# Plantilla .env para crear Secret/oscar-credentials (ns oscar) fuera de Git.
# Uso:
#   cp secrets/oscar-credentials.env.example secrets/oscar-credentials.env
#   # editar valores y NO commitear (secrets/*.env está gitignored)
#   kubectl -n oscar create secret generic oscar-credentials \
#     --from-env-file=secrets/oscar-credentials.env \
#     --dry-run=client -o yaml | kubectl apply -f -
# MINIO_ACCESS_KEY / MINIO_SECRET_KEY deben coincidir con
# Secret/minio-root-credentials (ns minio).
OSCAR_USERNAME=CHANGEME
OSCAR_PASSWORD=CHANGEME
MINIO_ACCESS_KEY=CHANGEME
MINIO_SECRET_KEY=CHANGEME
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
